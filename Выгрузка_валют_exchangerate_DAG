# Extract
def extract_data(url, s_file):
    data = req.get(url).json()
    with open(s_file, 'w') as f:
        json.dump(data, f)

# Transform
def transform_data(s_file, csv_file):
    data = json.load(open(s_file))
    rows = []
    for date, rates in data['quotes'].items():
        for code, value in rates.items():
            rows.append({'date': date, 'currency_source': code[:3], 'currency': code[3:], 'value': value})
    pd.DataFrame(rows).sort_values(['date', 'currency']).to_csv(csv_file, index=False)

# Load
def upload_to_clickhouse(csv_file, table_name, client):
    df = pd.read_csv(csv_file)
    client.execute(f"CREATE TABLE IF NOT EXISTS {table_name} (date String, currency_source String, currency String, value Float64) ENGINE = Log()")
    client.execute(f"TRUNCATE TABLE {table_name}")
    client.execute(f"INSERT INTO {table_name} (date, currency_source, currency, value) VALUES", list(df.itertuples(index=False, name=None)))

# DAG
